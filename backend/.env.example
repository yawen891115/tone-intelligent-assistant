# 复制成 .env 再改：cp .env.example .env

# ===== 文档 & 索引 =====
DOCS_DIR=data/demo_docs            # 换成真实文档：data/tone_docs（export_tone_docs.py 导出的）
INDEX_DIR=data/index
# 「来源链接」模板；文档 front matter 里写了 url 的以 front matter 为准
# URL_TEMPLATE=/api/assistant/doc/{path}
# URL_TEMPLATE=https://gitee.com/anolis/anolis-docs/blob/master/{path}

# ===== 切分 =====
CHUNK_MAX_CHARS=400
CHUNK_OVERLAP=80

# ===== Embedding（稠密检索）=====
EMBED_MODEL=BAAI/bge-small-zh-v1.5
# bge v1.5 可选的查询指令，不加也行；换别的模型时留空
EMBED_QUERY_PREFIX=
# EMBED_DEVICE=mps                 # Mac M 系列芯片可以用 mps，默认自动选择
# HF_ENDPOINT=https://hf-mirror.com  # 在国内下载模型慢时打开

# ===== 混合检索 =====
RRF_K=60
CANDIDATES=50
TOP_K=5

# ===== 大模型（可选：不配也能跑，只是返回检索到的片段）=====
# 通义千问·新加坡/国际站（在美国用这个）
# LLM_BASE_URL=https://dashscope-intl.aliyuncs.com/compatible-mode/v1
# 通义千问·北京
# LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# LLM_API_KEY=sk-xxxx
# LLM_MODEL=qwen-plus

# 本地 Ollama（先 ollama pull qwen2.5:7b）
# LLM_BASE_URL=http://localhost:11434/v1
# LLM_API_KEY=ollama
# LLM_MODEL=qwen2.5:7b

# ===== 服务 =====
CORS_ORIGINS=http://localhost:5173,http://localhost:8888
