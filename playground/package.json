        "react-dom": "^17.0.2",
        "styled-components": "^5.3.11"
    },
    "devDependencies": {
        "@types/marked": "^4.3.2",
        "@types/react": "^17.0.80",
        "@types/react-dom": "^17.0.25",
        "@types/styled-components": "^5.1.34",
        "@vitejs/plugin-react": "^4.3.0",
        "typescript": "^5.4.0",
        "vite": "^5.4.0"
    }
}
